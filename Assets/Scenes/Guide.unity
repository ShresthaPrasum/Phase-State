  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Controls\r\n- Move: A / D or Left / Right\r\n- Jump: Space (mainly useful
    in Solid)\r\n- Switch to Solid: 1\r\n- Switch to Liquid: 2\r\n- Switch to Gas:
    3\r\n- Respawn at checkpoint: R\r\n- Return to home/menu: Esc\r\n\r\nYour Goal\r\n1.
    Reach the portal to finish the level.\r\n2. Avoid hazards.\r\n3. Use the right
    form at the right time.\r\n\r\nForms\r\n- Solid;\r\n\t- Best for normal movement
    and jumping.\r\n\t- Spikes are dangerous in this form.\r\n\r\n- Liquid:\r\n\t-
    Useful for flowing through tighter paths.\r\n\t- Not killed by spikes.\r\n- Gas:\r\n\t-
    Floats and helps with vertical movement.\r\n\t- Not killed by spikes.\r\n\t-
    Gas uses may be limited depending on level settings.\r\n\r\n## Hazards\r\n- Killer/Spike
    objects: kill only when you are Solid.\r\n- Evaporator objects: kill only when
    you are Liquid."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
